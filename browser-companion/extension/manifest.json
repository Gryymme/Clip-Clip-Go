{
  "manifest_version": 3,
  "name": "ClipClipGO Companion",
  "version": "0.5.6",
  "minimum_chrome_version": "120",
  "description": "Find media on sites you permit and send a selected source to ClipClipGO.",
  "permissions": ["activeTab", "scripting", "webRequest", "webNavigation", "storage", "alarms", "nativeMessaging"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "icons": {"16": "icons/icon-16.png", "24": "icons/icon-24.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"},
  "action": { "default_popup": "popup.html", "default_title": "ClipClipGO", "default_icon": {"16": "icons/icon-16.png", "24": "icons/icon-24.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"} },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
