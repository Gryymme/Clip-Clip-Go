{
  "name": "clip-clip-go",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "engines:prepare": "node scripts/prepare-engines.mjs",
    "engines:verify": "node scripts/prepare-engines.mjs --verify-only",
    "pdf:prepare": "node scripts/prepare-pdf.mjs",
    "pdf:verify-resources": "node scripts/verify-pdf-resources.mjs",
    "desktop:dev": "npm run engines:prepare && npm run pdf:prepare && npm run dev",
    "desktop:build": "npm run engines:prepare && npm run pdf:prepare && npm run build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
