{
  "name": "clip-clip-go",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "icons:generate": "node scripts/generate-icons.mjs",
    "prebuild": "npm run icons:generate",
    "predesktop:dev": "npm run icons:generate",
    "predesktop:build": "npm run icons:generate",
    "engines:prepare": "node scripts/prepare-engines.mjs",
    "engines:verify": "node scripts/prepare-engines.mjs --verify-only",
    "downloader:prepare": "node scripts/prepare-downloader.mjs",
    "downloader:verify": "node scripts/prepare-downloader.mjs --verify-only",
    "pdf:prepare": "node scripts/prepare-pdf.mjs",
    "pdf:verify-resources": "node scripts/verify-pdf-resources.mjs",
    "desktop:dev": "npm run engines:prepare && npm run downloader:prepare && npm run pdf:prepare && npm run companion:build -- --debug && npm run dev",
    "desktop:build": "npm run engines:prepare && npm run downloader:prepare && npm run pdf:prepare && npm run companion:build && npm run build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "companion:build": "node scripts/build-companion.mjs",
    "companion:test": "node --experimental-strip-types --test tests/companion-extension.test.mjs tests/companion-observation.test.mjs tests/companion-preview.test.mjs tests/companion-setup.test.mjs",
    "companion:test-host": "node --test browser-companion/tests/native-host-process.test.mjs",
    "companion:fixtures": "node scripts/serve-companion-fixtures.mjs",
    "companion:check-ui": "node scripts/check-companion-layout.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
