{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clip-Clip-Go",
  "version": "0.1.0",
  "identifier": "com.clipclipgo.app",
  "build": {
    "beforeDevCommand": "npm run desktop:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run desktop:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clip-Clip-Go",
        "width": 1100,
        "height": 740,
        "minWidth": 640,
        "minHeight": 480,
        "backgroundColor": "#11141c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "useLocalToolsDir": true,
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "resources": { "../third-party/ffmpeg/": "notices/ffmpeg/" },
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
