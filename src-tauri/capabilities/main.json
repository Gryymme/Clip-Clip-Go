{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Allow the main local window to select files, inspect engines/media and manage one typed conversion. No shell or general filesystem access.",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-inspect-download",
    "allow-inspect-browser-download",
    "allow-companion-status",
    "allow-dismiss-browser-source",
    "allow-setup-browser-companion",
    "allow-connect-browser-companion",
    "allow-browser-companion-action",
    "allow-remove-browser-bridge",
    "allow-download-status",
    "allow-cancel-download",
    "allow-download-capabilities",
    "allow-plan-download",
    "allow-choose-download-folder",
    "allow-start-download",
    "allow-generate-preview",
    "allow-cancel-preview",
    "allow-select-media-file",
    "allow-select-images",
    "allow-probe-pdf",
    "allow-start-images-pdf",
    "allow-configure-engines",
    "allow-probe-media",
    "allow-probe-image",
    "allow-start-conversion",
    "allow-get-conversion-status",
    "allow-cancel-conversion",
    "allow-claim-drop",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
